# SQLite dosyası
DATABASE_PATH=./data/app.db

# Google servis hesabı (alan genelinde yetkili); dosya git'e eklenmez
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json
# Servis hesabının adına çalışacağı süper yönetici hesabı
GOOGLE_ADMIN_IMPERSONATE=

# İlk şifreleri şifreleyen 32 baytlık base64 anahtar. Bir kez belirlenir, değişirse kayıtlı şifreler çözülemez.
PASSWORD_ENC_KEY=

# Cloudflare Turnstile; geliştirmede boş bırakılabilir, üretimde zorunlu
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 1 ise worker kuyruğu Google'a kendisi gönderir (silmeler hariç). Boşken yalnızca izler.
SYNC_AUTO=

# Yönetim paneli köprüsü (Supabase); ikisi de boşken kapalıdır. Service role anahtarı yalnızca bu dosyada durur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Şifre sıfırlama ve e-posta onayı bağlantılarının adresi
APP_URL=https://dir.naal.org.tr

# SMTP sunucusu (Google Workspace); boşsa uyarılar pm2 günlüğüne yazılır, sertifikalar gönderilmez.
# Şifre, gönderen hesabın uygulama şifresidir. Gönderen adresler o hesabın takma adı olmalı.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Yöneticiye giden uyarı e-postaları (virgülle birden fazla adres); ALERT_EMAIL_FROM şifre sıfırlama e-postalarını da gönderir
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=NAAL Panel <panel@naal.org.tr>
# Toplu sertifika e-postalarının adresi; ad kulüpten gelir.
# Boşsa sertifikalar panelde "Bekliyor" olarak kalır.
CERT_EMAIL_FROM=sertifika@naal.org.tr

# Sunucu dışı yedek (deploy/backup-offsite.sh); yalnızca sunucuda gerekir
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP=90d
